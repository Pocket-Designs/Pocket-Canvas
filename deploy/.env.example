# Domain name clients use to reach the server, e.g. connect.example.com
# (for LAN-only use, a name your local DNS resolves, e.g. connect.home.lan)
PC_DOMAIN=connect.example.com

# Your public IPv4 address (the one your router has). Needed by the TURN relay.
PC_PUBLIC_IP=203.0.113.10

# Long random string shared by the server and TURN relay. Generate one with:
#   openssl rand -base64 48
PC_TURN_SECRET=change-me

# Who can create accounts: first-only (only the first account, which becomes admin),
# open (anyone who can reach the server), closed (nobody)
PC_REGISTRATION=first-only

# Leave empty for Let's Encrypt on a public domain.
# LAN-only: run ./make-cert.sh first, then use:  PC_TLS=/certs/cert.pem /certs/key.pem
PC_TLS=
