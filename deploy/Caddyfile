# HTTPS for the Pocket-Connect server.
# Public domain: leave PC_TLS empty in .env and Caddy gets a Let's Encrypt certificate.
# LAN only (no public DNS): run ./make-cert.sh, set PC_TLS=/certs/cert.pem /certs/key.pem
# in .env and pin the certificate fingerprint in the apps (see docs/SERVER-SETUP.md).
{$PC_DOMAIN} {
	tls {$PC_TLS}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy server:8443
}
